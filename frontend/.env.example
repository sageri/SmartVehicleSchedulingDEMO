# AI自動配車システムデモプロトタイプ - フロントエンド環境変数テンプレート
# このファイルをコピーして .env.local にリネームし、必要に応じて値を変更してください

# バックエンドAPIのベースURL
VITE_API_BASE_URL=http://localhost:8000

# アプリケーション設定
VITE_APP_TITLE=AI自動配車システム
VITE_APP_VERSION=1.0.0

# 地図設定
VITE_MAP_DEFAULT_CENTER_LAT=35.6812
VITE_MAP_DEFAULT_CENTER_LNG=139.7671
VITE_MAP_DEFAULT_ZOOM=13
