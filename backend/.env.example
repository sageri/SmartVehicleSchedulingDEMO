# AI自動配車システムデモプロトタイプ - 環境変数テンプレート
# このファイルをコピーして .env にリネームし、必要に応じて値を変更してください

# アプリケーション設定
APP_NAME="AI自動配車システム"
APP_VERSION="1.0.0"
DEBUG=True

# データベース設定
DATABASE_URL="sqlite:///./data/database.db"

# CORS設定（カンマ区切りで複数指定可能）
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# VRP最適化設定
VRP_TIME_LIMIT_SECONDS=10
VRP_SOLUTION_LIMIT=1000

# デモデータパス
DEMO_DATA_PATH="./data/demo_data"
